# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

/dist/
/.wrangler/
/.output/
/outputs/
/work/

# typescript incremental build cache
*.tsbuildinfo

# Generated by scripts/email-preview.mjs - synthetic previews, never committed.
email-preview/

# Stripe account recovery material. Untracked and credential-adjacent:
# it sat in the repository root with nothing stopping `git add .` from
# committing it. Ignored by exact name rather than by a pattern, so a
# future file is a deliberate decision rather than a silent match.
# Never read, never staged, never printed - see the launch audit.
stripe_backup_code.txt
