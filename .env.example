VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
SITE_URL=
SUPABASE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_CONTACT_FROM=

# Vercel Cron authentication for /api/cron/retry-order-notifications
# (internal order notification retry safety net). Vercel sends it as
# "Authorization: Bearer <CRON_SECRET>" on every scheduled invocation.
# Server-only, never VITE_-prefixed, never logged. When it is unset the
# endpoint refuses every request with 503 - it must never degrade into a
# public trigger for mail to orders@gloamatcha.com. Create a strong random
# value directly in the Vercel Production environment variables.
CRON_SECRET=

# Authorized shipment transition for POST /api/internal/orders/ship
# (Phase 2B). Server-only operator secret, sent as
# "Authorization: Bearer <FULFILLMENT_ADMIN_SECRET>".
#
# Deliberately its OWN secret. It must not be CRON_SECRET, and it must
# not be any Supabase, Stripe or Resend key: this endpoint changes
# fulfillment state and mails a customer, which is a larger blast radius
# than the cron's "re-attempt work already owed", and a secret shared
# between two endpoints makes each as reachable as the most widely copied
# instance of that value.
#
# Never VITE_-prefixed, never in a client bundle, never in a query
# parameter, never logged. When it is unset the endpoint refuses every
# request with 503 - it must never degrade into a public way to mark
# orders shipped. Generate a strong independent random value directly in
# the Vercel Production environment variables.
#
# Customer authentication is NOT authorization here: a signed-in customer
# has no path to this endpoint at all.
FULFILLMENT_ADMIN_SECRET=

# Authorized order cancellation for POST /api/internal/orders/cancel
# (Phase 2C). Server-only operator secret, sent as
# "Authorization: Bearer <CANCELLATION_ADMIN_SECRET>".
#
# A THIRD independent secret, and it must stay that way. It must not be
# FULFILLMENT_ADMIN_SECRET, must not be CRON_SECRET, and must not be any
# Supabase, Stripe or Resend key. The three operator endpoints have
# genuinely different blast radii - the cron re-attempts work already
# owed, the shipment endpoint ships an order and mails the customer, and
# this one STOPS fulfillment - and a secret shared between any two of
# them makes each as reachable as the most widely copied instance of that
# value.
#
# Never VITE_-prefixed, never in a client bundle, never in a query
# parameter, never logged. When it is unset the endpoint refuses every
# request with 503 - it must never degrade into a public way to cancel
# orders. Generate a strong independent random value directly in the
# Vercel Production environment variables, AFTER migration 029 has been
# reviewed and applied.
#
# Customer authentication is NOT authorization here: a signed-in customer
# has no path to this endpoint at all. The customer-facing
# /api/orders/cancellation-request remains a REQUEST only and is
# unchanged by this feature.
CANCELLATION_ADMIN_SECRET=

# B2C subscription checkout (Task 29D-D). Server-side feature gate.
# Only the exact string "true" enables it; missing, empty, "1" or "TRUE"
# all leave /api/subscriptions/checkout/session returning 503. Keep it
# unset until Task 29D-E is complete: until invoice.paid is handled, a
# subscription could be paid for and never activated.
B2C_SUBSCRIPTIONS_ENABLED=

# B2C PREPAID annual plan (Phase 4B2). Server-side feature gate, and a
# different product from the flexible subscription above: one upfront
# payment, thirteen deliveries 28 days apart, no renewal and no Stripe
# Subscription.
#
# Same convention as the flag above - only the exact string "true"
# enables it, and missing, empty, "1" or "TRUE" all leave it closed.
# Left UNSET here deliberately, like every other flag in this file: an
# empty value is not "true", so the safe state needs no keystroke.
#
# Keep it unset until the annual checkout, the payment webhook branch and
# the delivery fulfillment runtime exist. Migration 039 is applied, so the
# database could hold an annual plan today - but nothing yet creates one,
# pays for one or ships one, and a plan that was paid for and never
# activated is a worse failure than not offering it.
#
# Server-only. Never VITE_-prefixed and never in a client bundle: no UI
# reads it, and a public mirror would be a second place for it to
# disagree with the server.
B2C_ANNUAL_PLAN_ENABLED=

# Database integration tests only (npm run test:integration).
# MUST point at a dedicated NON-PRODUCTION Supabase project - the GLOA
# production project is hard-blocked by tests/helpers/testSupabase.mjs.
# The default `npm test` needs none of these and never writes to a database.
# Put real values in .env.test.local (git-ignored), never here.
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SECRET_KEY=
